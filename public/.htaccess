Options -MultiViews -Indexes

# Routes like /docs exist both as docs.html and as a docs/ directory (for the
# nested pages). With DirectorySlash on, mod_dir 301s /docs → /docs/ before the
# rewrite below can serve docs.html, and the trailing-slash rule sends it back:
# an endless redirect loop. Directory URLs are never served as such here.
DirectorySlash Off

RewriteEngine On

# www → non-www (301)
RewriteCond %{HTTP_HOST} ^www\.plumix\.net$ [NC]
RewriteRule ^(.*)$ https://plumix.net/$1 [R=301,L]

# http → https (301). Beget terminates SSL on nginx, so check
# X-Forwarded-Proto as well as HTTPS to avoid redirect loops.
RewriteCond %{HTTPS} !on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://plumix.net/$1 [R=301,L]

# Trailing slash → canonical extensionless URL (301), so /docs/ and /docs don't
# both resolve to a 200. Redirect targets are absolute: Apache sits behind
# Beget's TLS-terminating nginx and would otherwise build http:// locations.
RewriteRule ^(.+)/$ https://plumix.net/$1 [R=301,L]

# Direct requests for the prerendered files → their clean URL (301), so
# /docs.html and /index.html don't duplicate /docs and /. THE_REQUEST only sees
# the client's request line, not the internal /docs → /docs.html rewrite below.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
RewriteRule ^ https://plumix.net/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
RewriteRule ^ https://plumix.net/%1 [R=301,L]

# Serve the prerendered file for an extensionless route: /docs → /docs.html.
# docs/ also exists as a directory, so test for the file, not "not a directory".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Anything left over is genuinely missing. Fall through to ErrorDocument so it
# answers 404 instead of the old SPA fallback's soft 200.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # index.html and the other prerendered pages must revalidate so a deploy is
  # picked up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Vite fingerprints these filenames, so a changed file always has a new URL.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|avif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>
